# Frontend Environment Configuration Example
# For local development, default /api proxy works automatically.
# In production on Vercel, set VITE_API_URL to your Render backend API URL.
VITE_API_URL=https://your-backend-service.onrender.com/api

# Enable demo 1-click auto-login and demo role switcher (set false in production)
VITE_ENABLE_DEMO_AUTH=false
