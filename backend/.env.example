# Drug Court DSS Backend - Production Environment Variables Template

# Database Connection (Local SQLite or Remote Neon PostgreSQL)
DATABASE_URL=sqlite:///drugcourt_dev.db
# Example for Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Cryptographic Signing Key (Must be at least 32 characters in production)
SECRET_KEY=generate-a-strong-random-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External LLM Narrative APIs (Optional - falls back to local clinical rules if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Allowed CORS Origins (Include your Vercel frontend URL on Render)
CORS_ORIGINS=https://your-frontend-project.vercel.app,http://localhost:5173

# Environment & Debugging Mode (Set to production on Render)
ENVIRONMENT=development
DEBUG=false
